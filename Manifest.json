{
  "manifest_version": 3,
  "name": "OmniAssist AI - Universal Chat Recall & Productivity Suite",
  "short_name": "OmniAssist",
  "description": "Supercharge ChatGPT, Gemini, Claude, Perplexity, DeepSeek, Poe, and any AI chat with in-page search, memory recall, turn bookmarking, and local exports.",
  "version": "3.0.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
